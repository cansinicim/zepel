# Zepel Gayrimenkul, ortam değişkeni şablonu.
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# GERÇEK SIRLARI BU DOSYAYA YAZMAYIN, .env sürüm kontrolüne girmez.

# --- Genel ---
# Sitenin kanonik adresi (metadata, sitemap, canonical, OG görselleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node çalışma ortamı: development | production
NODE_ENV=development

# --- Docker / çalışma zamanı ---
# docker compose ile host tarafında yayınlanacak port
WEB_PORT=3000

# --- İletişim formu, e-posta sağlayıcısı (ileride) ---
# Kullanılacak sağlayıcı: resend | smtp
# CONTACT_EMAIL_PROVIDER=resend

# Resend kullanılacaksa
# RESEND_API_KEY=

# SMTP kullanılacaksa
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Form gönderimlerinin ulaşacağı adres ve gönderen kimliği
# CONTACT_FORM_TO_EMAIL=
# CONTACT_FORM_FROM_EMAIL=

# --- Analitik (ileride) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
